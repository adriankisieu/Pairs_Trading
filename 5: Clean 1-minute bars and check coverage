def prepare_data(raw, symbols):
    df = raw[['symbol', 'open', 'close', 'volume']].copy()
    if not isinstance(df.index, pd.DatetimeIndex):
        df.index = pd.to_datetime(df.index, utc=True)
    elif df.index.tz is None:
        df.index = df.index.tz_localize('UTC')
    df.index = df.index.tz_convert(TZ)
    df = df.between_time('09:30', '15:59')
    df = df[df.index.dayofweek < 5]
    for c in ['open', 'close', 'volume']:
        df[c] = pd.to_numeric(df[c], errors='coerce')
    df = df[(df.open > 0) & (df.close > 0) & (df.volume > 0)]
    df = df[~df.index.to_series().isna()]
    out = {}
    coverage = []
    for symbol in symbols:
        t = df[df.symbol == symbol][['open', 'close', 'volume']].copy()
        t = t[~t.index.duplicated(keep='last')].sort_index()
        if t.empty:
            coverage.append({'symbol': symbol, 'bars': 0, 'sessions': 0, 'large_daily_jump': np.nan})
            continue
        daily = t.groupby(t.index.date)['close'].last()
        big_jump = float(daily.pct_change().abs().max())
        out[symbol] = t
        coverage.append({'symbol': symbol, 'bars': len(t), 'sessions': len(daily),
                         'first': t.index.min().date(), 'last': t.index.max().date(),
                         'large_daily_jump': round(big_jump, 3)})
    return out, pd.DataFrame(coverage)

