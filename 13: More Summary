
if trades.empty:
    print("No completed trades.")
else:
    history = trades.copy().sort_values("entry").reset_index(drop=True)

    history.insert(0, "Trade #", range(1, len(history) + 1))

    history["Long Stock"] = history.apply(
        lambda x: x["pair"].split("/")[0] if x["qty_a"] > 0
        else x["pair"].split("/")[1], axis=1
    )

    history["Short Stock"] = history.apply(
        lambda x: x["pair"].split("/")[1] if x["qty_a"] > 0
        else x["pair"].split("/")[0], axis=1
    )

    # Entry prices and dollar exposure for each leg
    def get_exposure(row):
        prices = all_signals[row["pair"]].loc[row["entry"]]

        a = abs(row["qty_a"]) * prices["oa"]
        b = abs(row["qty_b"]) * prices["ob"]

        if row["qty_a"] > 0:
            return pd.Series([a, b])
        return pd.Series([b, a])

    history[["Long ($)", "Short ($)"]] = history.apply(
        get_exposure, axis=1
    )

    history["Total Equity ($)"] = (
        history["Long ($)"] + history["Short ($)"]
    )

    history["Entry Time"] = history["entry"].dt.strftime("%Y-%m-%d %H:%M")
    history["Exit Time"] = history["exit"].dt.strftime("%Y-%m-%d %H:%M")

    history = history.rename(columns={
        "pair": "Pair",
        "net_pnl": "Net P&L ($)",
        "exit_reason": "Exit Reason",
        "calendar_days": "Days Held"
    })

    history = history[[
        "Trade #", "Pair", "Long Stock", "Long ($)",
        "Short Stock", "Short ($)", "Total Equity ($)",
        "Entry Time", "Exit Time", "Days Held",
        "Net P&L ($)", "Exit Reason"
    ]]

    for col in ["Long ($)", "Short ($)", "Total Equity ($)",
                "Days Held", "Net P&L ($)"]:
        history[col] = history[col].round(2)

    pd.set_option("display.max_rows", None)
    display(history)

    print(f"\nTotal trades: {len(history)}")
    print(f"Winning trades: {(history['Net P&L ($)'] > 0).sum()}")
    print(f"Losing trades: {(history['Net P&L ($)'] < 0).sum()}")
    print(f"Total net P&L: ${history['Net P&L ($)'].sum():,.2f}")
